---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { site, mailto } from '../config/site';
import { getServices, pad } from '../lib/content';

const services = await getServices();
const [emailUser, emailDomain] = site.email.split('@');
const trail = [{ name: 'Contact', href: '/contact/' }];
const checklist = [
  { title: 'The component or system', text: 'What it is, what it does and where it sits: a part, an assembly, a piping system or a whole layout.' },
  { title: 'The deliverable', text: '3D models, 2D drawings, calculations, a design review, a stress check or a training session.' },
  { title: 'Existing information', text: 'Sketches, legacy drawings, models (with file formats), photos or specifications.' },
  { title: 'Codes and standards', text: 'Any ASME, API, ISO or client standards the work must follow.' },
  { title: 'Timeline', text: 'When you need it, and whether there are review stages along the way.' },
];
const channels = [
  { ...site.social.linkedin, icon: 'linkedin' as const, note: 'Professional profile and messages' },
  { ...site.social.youtube, icon: 'youtube' as const, note: 'Tutorials and comments' },
  { ...site.social.blog, icon: 'blog' as const, note: 'Articles and notes' },
];
const enquiry = mailto('Project enquiry: INSPIREWORKSS');
---

<BaseLayout
  title="Contact"
  description={`Contact INSPIREWORKSS for mechanical design, piping engineering, analysis, consulting or CAD/CAE training. Email ${site.email} or connect with Avani Jangam on LinkedIn.`}
  trail={trail}
>
  <TitleBlock
    eyebrow="Contact"
    title="Get in touch"
    lead="Email is the fastest way to reach INSPIREWORKSS about a project, training or a question about a drawing."
    trail={trail}
  >
    <div slot="aside" class="card contact-card">
      <p class="label">Email</p>
      <a href={enquiry} class="contact-email">{emailUser}@<wbr />{emailDomain}</a>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href={enquiry} class="btn btn-primary"><Icon name="mail" /> Write an email</a>
        <button type="button" class="btn btn-ghost" data-copy={site.email}>
          <Icon name="copy" />
          <span data-copy-label>Copy address</span>
        </button>
      </div>
      <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>

      <ul class="mt-7 border-t border-line" aria-label="Other channels">
        {
          channels.map((c) => (
            <li class="border-b border-line last:border-b-0">
              <a href={c.url} target="_blank" rel="me noopener" class="channel-row">
                <Icon name={c.icon} size={20} />
                <span class="flex-1">
                  <span class="block font-semibold">{c.label}</span>
                  <span class="block text-sm text-ink-3">{c.note}</span>
                </span>
                <Icon name="arrow-up-right" size={18} />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </TitleBlock>

  <section class="pt-16 sm:pt-20 lg:pt-24" aria-labelledby="brief-title">
    <div class="container-x">
      <div class="surface surface-tint" data-reveal>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-5">
            <p class="eyebrow">Enquiry checklist</p>
            <h2 id="brief-title" class="heading-xl mt-4">What to include in your email</h2>
            <p class="lead mt-5">A short brief makes the first reply useful. None of it is required, so send what you have.</p>
          </div>
          <ol class="lg:col-span-7">
            {
              checklist.map((c, i) => (
                <li class="check-row">
                  <span class="check-num">{pad(i + 1)}</span>
                  <div>
                    <h3 class="heading-md">{c.title}</h3>
                    <p class="mt-1 text-ink-2">{c.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24" aria-labelledby="topic-title">
    <div class="container-x">
      <SectionHeading
        eyebrow="Quick start"
        id="topic-title"
        title="Email about a specific service"
        intro="Each link opens a new email with the subject line already filled in."
      />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s, i) => (
            <li data-reveal style={`--reveal-i: ${i % 4}`}>
              <a href={mailto(`Enquiry: ${s.data.title}`)} class="card topic">
                <span class="heading-md block">{s.data.title}</span>
                <span class="topic-cta mt-5">
                  <Icon name="mail" size={16} /> Email about this
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-card {
    padding: 1.75rem;
  }

  .contact-email {
    display: block;
    margin-top: 0.35rem;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 1.9rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  .contact-email:hover {
    color: var(--c-accent);
  }

  .channel-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.9rem;
    transition: color 0.2s ease;
  }

  .channel-row:hover {
    color: var(--c-accent);
  }

  .check-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--c-line-strong);
  }

  .check-row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .check-num {
    padding-top: 0.2rem;
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--c-accent);
  }

  .topic {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    transition: border-color 0.25s ease;
  }

  .topic:hover {
    border-color: var(--c-ink);
  }

  .topic-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--c-ink-3);
  }

  .topic:hover .topic-cta {
    color: var(--c-accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('[data-copy-label]');
    const status = document.querySelector('[data-copy-status]');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
        if (status) status.textContent = 'Email address copied to clipboard';
        setTimeout(() => label && (label.textContent = 'Copy address'), 2200);
      } catch {
        if (status) status.textContent = 'Copy failed. Please select the address manually.';
      }
    });
  });
</script>
