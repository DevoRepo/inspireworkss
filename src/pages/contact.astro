---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import SectionHeading from '../components/SectionHeading.astro';
import DimensionLine from '../components/DimensionLine.astro';
import Icon from '../components/Icon.astro';
import { site, mailto } from '../config/site';
import { getServices, pad } from '../lib/content';

const services = await getServices();
const [emailUser, emailDomain] = site.email.split('@');
const trail = [{ name: 'Contact', href: '/contact/' }];
const checklist = [
  { title: 'The component or system', text: 'What it is, what it does and where it sits — a part, an assembly, a piping system or a whole layout.' },
  { title: 'The deliverable', text: '3D models, 2D drawings, calculations, a design review, a stress check or a training session.' },
  { title: 'Existing information', text: 'Sketches, legacy drawings, models (with file formats), photos or specifications.' },
  { title: 'Codes & standards', text: 'Any ASME, API, ISO or client standards the work must follow.' },
  { title: 'Timeline', text: 'When you need it, and whether there are review stages along the way.' },
];
const channels = [
  { ...site.social.linkedin, icon: 'linkedin' as const, note: 'Professional profile & messages' },
  { ...site.social.youtube, icon: 'youtube' as const, note: 'Tutorials & comments' },
  { ...site.social.blog, icon: 'blog' as const, note: 'Articles & notes' },
];
---

<BaseLayout
  title="Contact"
  description={`Contact INSPIREWORKSS for mechanical design, piping engineering, analysis, consulting or CAD/CAE training. Email ${site.email} or connect with Avani Jangam on LinkedIn.`}
  trail={trail}
>
  <TitleBlock
    eyebrow="Contact"
    title="Let's talk engineering"
    lead="For projects, collaborations, training or a question about a drawing — email is the fastest way to reach INSPIREWORKSS."
    sheet="07 / 07"
    meta={[
      { label: 'Title', value: 'Contact' },
      { label: 'Channel', value: 'Email' },
      { label: 'LinkedIn', value: site.social.linkedin.handle },
    ]}
    trail={trail}
  />

  <section class="py-16 sm:py-20 lg:py-24" aria-labelledby="email-title">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow" id="email-title">Primary channel · Email</p>
        <a href={mailto('Project enquiry — INSPIREWORKSS')} class="email-big mt-4 block">
          {emailUser}@<wbr />{emailDomain}
        </a>
        <DimensionLine label="Write to the studio" class="mt-6 max-w-xl" />
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={mailto('Project enquiry — INSPIREWORKSS')} class="btn btn-primary">
            <Icon name="mail" /> Write an email
          </a>
          <button type="button" class="btn btn-ghost" data-copy={site.email}>
            <Icon name="copy" class="copy-icon" />
            <span data-copy-label>Copy address</span>
          </button>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
      </div>

      <div class="lg:col-span-5" data-reveal style="--reveal-i: 1">
        <p class="eyebrow">Other channels</p>
        <ul class="mt-4 border-t border-ink">
          {
            channels.map((c) => (
              <li class="border-b border-line">
                <a href={c.url} target="_blank" rel="me noopener" class="channel-row">
                  <Icon name={c.icon} size={20} />
                  <span class="flex-1">
                    <span class="block font-semibold">{c.label}</span>
                    <span class="block text-sm text-ink-3">{c.note}</span>
                  </span>
                  <Icon name="arrow-up-right" size={18} />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="grid-paper border-y border-line py-20 sm:py-24" aria-labelledby="brief-title">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading
          mark="A"
          eyebrow="Enquiry checklist"
          id="brief-title"
          title="What to include in your email."
          intro="A short brief makes the first reply useful. None of this is required — send what you have."
        />
      </div>
      <ol class="border-t border-ink lg:col-span-7" data-reveal>
        {
          checklist.map((c, i) => (
            <li class="grid gap-1 border-b border-line bg-sheet/60 px-1 py-5 sm:grid-cols-[3rem_1fr]">
              <span class="mono text-xs text-accent">{pad(i + 1)}</span>
              <div>
                <h3 class="heading-md">{c.title}</h3>
                <p class="mt-1 text-ink-2">{c.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-20 sm:py-24" aria-labelledby="topic-title">
    <div class="container-x">
      <SectionHeading
        mark="B"
        eyebrow="Quick start"
        id="topic-title"
        title="Email about a specific service."
        intro="Each link opens a new email with the subject line already filled in."
      />
      <ul class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s, i) => (
            <li class="bg-paper" data-reveal style={`--reveal-i: ${i % 4}`}>
              <a href={mailto(`Enquiry: ${s.data.title}`)} class="topic">
                <span class="mono text-xs text-ink-3">{pad(s.data.order)}</span>
                <span class="heading-md mt-3 block">{s.data.title}</span>
                <span class="topic-cta mt-5">
                  <Icon name="mail" size={16} /> Email about this
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .email-big {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 0.9rem + 3.4vw, 3.75rem);
    overflow-wrap: anywhere;
    line-height: 1;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }

  .email-big:hover {
    color: var(--c-accent);
  }

  .channel-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0.25rem;
    transition: color 0.2s ease, padding 0.3s ease;
  }

  .channel-row:hover {
    color: var(--c-accent);
    padding-left: 0.75rem;
  }

  .topic {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    transition: background-color 0.25s ease;
  }

  .topic:hover {
    background: var(--c-sheet);
  }

  .topic-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-3);
  }

  .topic:hover .topic-cta {
    color: var(--c-accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('[data-copy-label]');
    const status = document.querySelector('[data-copy-status]');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
        if (status) status.textContent = 'Email address copied to clipboard';
        setTimeout(() => label && (label.textContent = 'Copy address'), 2200);
      } catch {
        if (status) status.textContent = 'Copy failed — please select the address manually';
      }
    });
  });
</script>
