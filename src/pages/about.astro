---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { getCredentials, getTools, isEngineeringTool, pad } from '../lib/content';
import logo from '../assets/brand/inspireworkss-logo.png';

// CAD/CAE packages plus Python (named in the profile); general office tools are left out.
const tools = (await getTools()).filter((t) => isEngineeringTool(t) || t.id === 'python');
const credentials = await getCredentials();
const credentialGroups = [
  { type: 'experience', label: 'Experience' },
  { type: 'education', label: 'Education' },
  { type: 'certification', label: 'Certifications' },
] as const;

const domains = [
  { name: 'Mechanical engineering', text: 'Mechanical, product and machine design, engineering calculations, design optimisation and DFM.' },
  { name: 'Piping engineering', text: 'Piping design, routing and supports, plant and equipment layout, pipe stress analysis and pressure vessels.' },
  { name: 'Marine engineering', text: 'Part of the same ongoing journey of exploring how engineered systems are designed and built.' },
];

const teaching = [
  'Mentors students and professionals',
  'Creates technical courses and tutorials',
  'Runs the INSPIREWORKSS YouTube channel and blog',
  'Encourages practical problem-solving and critical thinking',
];

const hobbies = ['Reading books', 'Watching anime', 'Listening to podcasts', 'Martial arts', 'Content creation'];
const links = [
  { ...site.social.linkedin, icon: 'linkedin' as const },
  { ...site.social.youtube, icon: 'youtube' as const },
  { ...site.social.blog, icon: 'blog' as const },
];
const trail = [{ name: 'About', href: '/about/' }];
---

<BaseLayout
  title={`About ${site.owner}`}
  description={`Meet ${site.owner}, the engineer behind INSPIREWORKSS: mechanical, piping and marine engineering, CAD/CAE software, codes and standards, and a focus on teaching the how and the why.`}
  type="profile"
  trail={trail}
>
  <TitleBlock
    eyebrow="About"
    title={site.owner}
    lead="An engineer on a never-ending journey of exploring mechanical, piping and marine engineering, and the person behind INSPIREWORKSS."
    meta={[
      { label: 'Disciplines', value: site.disciplines.join(' · ') },
      { label: 'Software', value: `${tools.filter(isEngineeringTool).length} CAD/CAE packages, Python` },
      { label: 'Standards', value: 'ASME · API · ISO · GD&T' },
      { label: 'Teaching', value: 'YouTube · Blog · Courses' },
    ]}
    trail={trail}
  >
    <figure slot="aside" class="plate">
      <Image
        src={logo}
        alt="The INSPIREWORKSS IW monogram: an isometric hexagon in brushed steel and red with drafting construction lines."
        widths={[400, 640, 900]}
        sizes="(min-width: 64rem) 34vw, 90vw"
        loading="eager"
      />
    </figure>
  </TitleBlock>

  <!-- Profile -->
  <section class="py-20 sm:py-24 lg:py-28" aria-labelledby="profile-title">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="Profile" id="profile-title" title="Design, analysis and teaching" />
        <div class="prose-body mt-8 max-w-2xl text-lg" data-reveal>
          <p>
            {site.owner} works across mechanical, piping and marine engineering, and treats every project as a chance to turn a
            complex engineering challenge into a practical, optimised solution.
          </p>
          <p>
            Beyond professional work, {site.owner} teaches and shares engineering knowledge through the {site.name} website and
            YouTube channel, simplifying complex concepts with a focus on both the <strong class="font-semibold text-ink">how</strong> and
            the <strong class="font-semibold text-ink">why</strong>.
          </p>
          <p>
            The toolset covers AutoCAD, SolidWorks, Creo, NX, Inventor, E3D, Navisworks, Plant 3D, PV Elite and Caesar II, backed by
            strong knowledge of design, codes and standards, GD&amp;T and Python-based automation.
          </p>
          <p>Driven by curiosity and continuous learning, the aim is to make engineering more accessible, engaging and impactful.</p>
        </div>
      </div>

      <aside class="lg:col-span-5" aria-labelledby="toolset-title" data-reveal>
        <div class="card toolset">
          <h2 id="toolset-title" class="heading-md">Toolset</h2>
          <p class="mt-1 text-sm text-ink-3">CAD, plant design, analysis and automation</p>
          <ul class="mt-5 grid grid-cols-2 gap-x-5">
            {
              tools.map((t) => (
                <li class="tool-item">
                  <span class="tool-dot" aria-hidden="true" />
                  {t.data.name}
                </li>
              ))
            }
          </ul>
          <a href={url('/expertise/')} class="link-arrow mt-6">All skills and software <Icon name="arrow" /></a>
        </div>
      </aside>
    </div>
  </section>

  <!-- In Avani's words (verbatim from the Notion profile) -->
  <section aria-label="In Avani Jangam's words">
    <div class="container-x">
      <figure class="surface surface-blush quote" data-reveal>
        <span class="quote-mark" aria-hidden="true">“</span>
        <blockquote>
          <p>For me, every project is an opportunity to translate complex engineering challenges into practical, optimized solutions.</p>
        </blockquote>
        <figcaption class="mt-8 flex items-center gap-3">
          <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
          <span class="font-semibold">{site.owner}</span>
          <span class="text-ink-3">· {site.name}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Domains -->
  <section class="py-20 sm:py-24 lg:py-28" aria-labelledby="domains-title">
    <div class="container-x">
      <SectionHeading eyebrow="Domains" id="domains-title" title="Three engineering domains" />
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {
          domains.map((d, i) => (
            <li class="card p-7 sm:p-8" data-reveal style={`--reveal-i: ${i}`}>
              <span class="domain-rule" aria-hidden="true" />
              <h3 class="heading-lg mt-6">{d.name}</h3>
              <p class="mt-3 text-ink-2">{d.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Teaching -->
  <section class="border-t border-line py-20 sm:py-24 lg:py-28" aria-labelledby="teaching-title">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <SectionHeading
          eyebrow="Teaching and mentoring"
          id="teaching-title"
          title="Making engineering accessible"
        />
      </div>
      <div class="lg:col-span-6" data-reveal>
        <ul class="border-t border-line-strong">
          {
            teaching.map((t, i) => (
              <li class="flex items-baseline gap-5 border-b border-line py-4 text-lg">
                <span class="teach-num">{pad(i + 1)}</span>
                {t}
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-wrap gap-6">
          <a href={url('/resources/')} class="link-arrow">Tutorials <Icon name="arrow" /></a>
          <a href={url('/services/corporate-cad-cae-training/')} class="link-arrow">CAD/CAE training <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  {
    credentials.length > 0 && (
      <section class="border-t border-line py-20 sm:py-24 lg:py-28" aria-labelledby="record-title">
        <div class="container-x">
          <SectionHeading eyebrow="Record" id="record-title" title="Experience and qualifications" />
          <div class="mt-12 grid gap-12 lg:grid-cols-3">
            {credentialGroups.map((group) => {
              const items = credentials.filter((c) => c.data.type === group.type);
              return (
                items.length > 0 && (
                  <div data-reveal>
                    <h3 class="heading-md">{group.label}</h3>
                    <ul class="mt-4 border-t border-line-strong">
                      {items.map((c) => (
                        <li class="border-b border-line py-4">
                          <p class="heading-md">{c.data.title}</p>
                          <p class="mt-1 text-ink-2">
                            {c.data.organisation}
                            {c.data.period && <span class="ml-2 text-sm text-ink-3">{c.data.period}</span>}
                          </p>
                          {c.data.description && <p class="mt-2 text-[0.95rem] text-ink-2">{c.data.description}</p>}
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- Outside engineering + links -->
  <section class="border-t border-line bg-sheet py-20 sm:py-24" aria-labelledby="off-title">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow">Off the drawing board</p>
        <h2 id="off-title" class="heading-xl mt-4">Outside engineering</h2>
        <ul class="mt-8 flex flex-wrap gap-2">
          {hobbies.map((h) => <li class="chip !text-sm">{h}</li>)}
        </ul>
      </div>
      <div class="lg:col-span-6" data-reveal>
        <h2 class="heading-md">Find {site.owner} online</h2>
        <ul class="mt-5 border-t border-line-strong">
          {
            links.map((l) => (
              <li class="border-b border-line">
                <a href={l.url} target="_blank" rel="me noopener" class="online-link">
                  <Icon name={l.icon} size={20} />
                  <span class="flex-1">
                    <span class="block font-semibold">{l.label}</span>
                    <span class="block text-sm text-ink-3">{l.handle}</span>
                  </span>
                  <Icon name="arrow-up-right" size={20} />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CTABand title="Work with INSPIREWORKSS" />
</BaseLayout>

<style>
  .plate {
    max-width: 26rem;
    margin-inline: auto;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--radius-block);
    background: var(--c-plate);
    box-shadow: 0 30px 60px -36px rgb(17 18 20 / 0.55);
  }

  .plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .toolset {
    padding: 1.75rem;
  }

  .tool-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--c-line);
    font-size: 0.95rem;
  }

  .tool-dot {
    width: 0.4rem;
    height: 0.4rem;
    flex: none;
    border-radius: 999px;
    background: var(--c-accent);
  }

  .quote {
    position: relative;
    overflow: hidden;
  }

  .quote-mark {
    position: absolute;
    top: -0.15em;
    right: 0.1em;
    font-size: clamp(9rem, 6rem + 12vw, 18rem);
    font-weight: 600;
    line-height: 1;
    color: var(--c-accent);
    opacity: 0.14;
    pointer-events: none;
  }

  .quote blockquote p {
    position: relative;
    max-width: 52rem;
    font-size: clamp(1.6rem, 1.1rem + 2.1vw, 2.9rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .domain-rule {
    display: block;
    width: 2rem;
    height: 2px;
    background: var(--c-accent);
  }

  .teach-num {
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--c-ink-3);
  }

  .online-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0.25rem;
    transition: color 0.2s ease, padding 0.3s ease;
  }

  .online-link:hover {
    color: var(--c-accent);
    padding-left: 0.75rem;
  }
</style>
