---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SpecTable from '../components/SpecTable.astro';
import CTABand from '../components/CTABand.astro';
import { expertiseCategories } from '../content.config';
import { getSkillApplications, getSkills, getTools, groupBy, isEngineeringTool, pad } from '../lib/content';

const skills = await getSkills();
const byCategory = expertiseCategories.map((c) => [c, skills.filter((s) => s.data.category === c)] as const);
const tools = await getTools();
const toolGroups = groupBy(tools, (t) => t.data.group);
const applications = await getSkillApplications();
const engineeringTools = tools.filter(isEngineeringTool);
const appliedIn = (id: string) => (applications.get(id) ?? []).map((svc) => ({ label: svc.data.title, href: `/services/${svc.id}/` }));
const slug = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const trail = [{ name: 'Expertise', href: '/expertise/' }];
---

<BaseLayout
  title="Engineering Skills & Software Expertise"
  description="INSPIREWORKSS expertise: mechanical design, piping engineering, pipe stress analysis, pressure vessel design, CAD/CAE, GD&T, ASME/API/ISO standards and Python automation — with AutoCAD, SolidWorks, Creo, NX, Inventor, E3D, Plant 3D, Navisworks, PV Elite and Caesar II."
  trail={trail}
>
  <TitleBlock
    eyebrow="Specification sheet"
    title="Expertise"
    lead="Every skill, standard and software package behind INSPIREWORKSS — and where each one is put to work."
    meta={[
      { label: 'Skills', value: `${skills.length} across ${byCategory.length} disciplines` },
      { label: 'Software', value: `${pad(engineeringTools.length)} CAD / CAE packages` },
    ]}
    trail={trail}
  >
    <nav aria-label="Expertise categories" class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {
          byCategory.map(([c]) => (
            <li>
              <a href={`#${slug(c)}`} class="chip">
                {c}
              </a>
            </li>
          ))
        }
        <li><a href="#software" class="chip">Software</a></li>
      </ul>
    </nav>
  </TitleBlock>

  <section class="py-16 sm:py-20 lg:py-24" aria-label="Skills by category">
    <div class="container-x space-y-20 lg:space-y-28">
      {
        byCategory.map(([category, items]) => (
          <div class="grid gap-8 lg:grid-cols-12" id={slug(category)}>
            <div class="lg:col-span-4">
              <SectionHeading eyebrow={`${pad(items.length)} skills`} title={category} />
            </div>
            <div class="lg:col-span-8" data-reveal>
              <SpecTable
                caption={`${category} skills`}
                hideCaption
                itemLabel="Skill"
                rows={items.map((s) => ({ name: s.data.skill, note: s.data.note, links: appliedIn(s.id) }))}
              />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="software" class="grid-paper border-y border-line py-20 sm:py-24 lg:py-28" aria-labelledby="software-title">
    <div class="container-x">
      <SectionHeading
        eyebrow="Software"
        id="software-title"
        title="CAD, plant design and analysis packages."
        intro="From 2D drafting to pipe stress analysis — the packages behind every deliverable."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {
          toolGroups.map(([group, items], i) => (
            <section class="card tool-card" data-reveal style={`--reveal-i: ${i % 2}`} aria-labelledby={`tools-${slug(group)}`}>
              <h3 id={`tools-${slug(group)}`} class="heading-md">{group}</h3>
              <ul class="mt-4">
                {items.map((t) => (
                  <li class="tool-row">
                    <span class="font-semibold tracking-[-0.01em]">{t.data.name}</span>
                    <span class="text-[0.95rem] text-ink-2">{t.data.use}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand title="Need these skills on your project?" />
</BaseLayout>

<style>
  .tool-card {
    padding: 1.75rem 1.75rem 0.75rem;
  }

  .tool-row {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--c-line);
  }

  @media (min-width: 40rem) {
    .tool-card {
      padding: 2rem 2rem 1rem;
    }
  }
</style>
