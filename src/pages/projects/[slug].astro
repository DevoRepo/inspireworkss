---
import { url } from '../../lib/url';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import { getProjects, resolveTools, youtubeUrl, type Project } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length], all: projects },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
  all: Project[];
}

const { project, next, all } = Astro.props;
const { data } = project;
const tools = await resolveTools(data.tools);
const services = data.services.length ? await getEntries(data.services) : [];
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());
const others = all.filter((p) => p.id !== project.id && p.id !== next.id).slice(0, 3);

/** Problem → approach → outcome, only for the parts that exist. */
const story = [
  { key: 'Problem', text: data.problem },
  { key: 'Approach', text: data.approach },
  { key: 'Outcome', text: data.outcome },
].filter((s): s is { key: string; text: string } => Boolean(s.text));

const trail = [
  { name: 'Projects', href: '/projects/' },
  { name: data.title, href: `/projects/${project.id}/` },
];

const meta = [
  { label: 'Discipline', value: data.discipline },
  { label: 'Category', value: data.category },
  { label: 'Format', value: data.format },
  ...(tools.length ? [{ label: 'Software', value: tools.map((t) => t.data.name).join(', ') }] : []),
];

const schema = [
  {
    '@type': 'CreativeWork',
    name: data.title,
    description: data.summary,
    genre: data.discipline,
    creator: { '@id': new URL(url('/#avani-jangam'), Astro.site).href },
    url: new URL(url(`/projects/${project.id}/`), Astro.site).href,
    ...(data.youtubeId ? { sameAs: youtubeUrl(data.youtubeId) } : {}),
  },
];
---

<BaseLayout
  title={`${data.title} — ${data.category}`}
  description={data.summary}
  image={data.cover}
  imageAlt={data.coverAlt}
  type="article"
  trail={trail}
  schema={schema}
>
  <TitleBlock eyebrow={data.discipline} title={data.title} lead={data.summary} meta={meta} trail={trail} />

  <!-- Media -->
  <section class="pt-12 sm:pt-16" aria-label="Project media">
    <div class="container-x">
      <figure data-reveal>
        {
          data.youtubeId ? (
            <VideoFacade id={data.youtubeId} title={data.title} sizes="(min-width: 84rem) 1280px, 100vw" eager />
          ) : (
            <div class="still">
              <Image src={data.cover} alt={data.coverAlt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 84rem) 1280px, 100vw" loading="eager" fetchpriority="high" />
            </div>
          )
        }
        {
          data.youtubeId && (
            <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-3">
              <span class="label">Full build on the INSPIREWORKSS YouTube channel</span>
              <a href={youtubeUrl(data.youtubeId)} class="link-arrow" target="_blank" rel="noopener">
                Watch on YouTube <Icon name="arrow-up-right" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </figcaption>
          )
        }
      </figure>
    </div>
  </section>

  <!-- Highlights / story -->
  <section class="py-20 sm:py-24" aria-labelledby="detail-title">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="Design detail" id="detail-title" title="What the model shows" />

        {
          data.highlights.length > 0 && (
            <ul class="mt-10 border-t border-line-strong" data-reveal>
              {data.highlights.map((h) => (
                <li class="flex gap-4 border-b border-line py-4 text-lg">
                  <span class="hl-check" aria-hidden="true">
                    <Icon name="check" size={14} />
                  </span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )
        }

        {
          story.length > 0 && (
            <dl class="mt-12 space-y-8" data-reveal>
              {story.map((s) => (
                <div class="grid gap-2 sm:grid-cols-[9rem_1fr]">
                  <dt class="label pt-1">{s.key}</dt>
                  <dd class="text-lg text-ink-2">{s.text}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          hasBody && (
            <div class="prose-body mt-12 text-lg" data-reveal>
              <Content />
            </div>
          )
        }
      </div>

      {
        services.length > 0 && (
          <aside class="lg:col-span-4 lg:col-start-9" aria-labelledby="services-title" data-reveal>
            <div class="card side">
              <h2 id="services-title" class="heading-md">Related services</h2>
              <ul class="mt-4">
                {services.map((s) => (
                  <li class="border-t border-line first:border-t-0">
                    <a href={url(`/services/${s.id}/`)} class="side-link">
                      <span>{s.data.title}</span>
                      <Icon name="arrow" size={18} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </section>

  <!-- Next project -->
  <section class="border-t border-line bg-sheet" aria-labelledby="next-title">
    <a href={url(`/projects/${next.id}/`)} class="next container-x grid items-center gap-8 py-14 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="label">Next project →</p>
        <h2 id="next-title" class="heading-xl mt-3">{next.data.title}</h2>
        <p class="mt-3 text-ink-2">{next.data.category} · {next.data.format}</p>
      </div>
      <div class="next-thumb md:col-span-5">
        <Image src={next.data.cover} alt="" widths={[480, 720]} sizes="(min-width: 48rem) 40vw, 100vw" />
      </div>
    </a>
  </section>

  {
    others.length > 0 && (
      <section class="pt-20 sm:pt-24" aria-labelledby="more-title">
        <div class="container-x">
          <h2 id="more-title" class="heading-lg">More projects</h2>
          <ul class="mt-8 grid gap-5 sm:grid-cols-3">
            {others.map((p, i) => (
              <li data-reveal style={`--reveal-i: ${i}`}>
                <ProjectCard project={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CTABand title="Need something like this designed?" subject={`Enquiry about: ${data.title}`} />
</BaseLayout>

<style>
  .still,
  .next-thumb {
    position: relative;
  }

  .still::after,
  .next-thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--c-line);
    pointer-events: none;
  }

  .still {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #fff;
  }

  .still :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hl-check {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.2rem;
    border-radius: 999px;
    background: var(--c-accent);
    color: var(--c-accent-ink);
  }

  .side {
    position: sticky;
    top: 6.5rem;
    padding: 1.5rem 1.75rem;
  }

  .side-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .side-link:hover {
    color: var(--c-accent);
  }

  .next-thumb {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--c-line);
  }

  .next-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .next:hover .next-thumb :global(img) {
    transform: scale(1.04);
  }

  .next:hover h2 {
    color: var(--c-accent);
  }
</style>
