---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import SectionHeading from '../components/SectionHeading.astro';
import VideoFacade from '../components/VideoFacade.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { getVideos, pad, youtubeUrl } from '../lib/content';

const videos = await getVideos();
const [lead, ...rest] = videos;
const trail = [{ name: 'Resources', href: '/resources/' }];
const channels = [
  {
    ...site.social.youtube,
    icon: 'youtube' as const,
    title: 'INSPIREWORKSS on YouTube',
    text: 'SolidWorks builds, modelling techniques and engineering-drawing exercises.',
  },
  {
    ...site.social.blog,
    icon: 'blog' as const,
    title: 'The blog',
    text: 'Written engineering notes and articles by Avani Jangam.',
  },
];
---

<BaseLayout
  title="Engineering Tutorials & Resources"
  description="Free mechanical engineering tutorials from INSPIREWORKSS — SolidWorks modelling builds, design techniques and engineering drawing exercises on YouTube, plus the INSPIREWORKSS blog."
  trail={trail}
>
  <TitleBlock
    eyebrow="Learn with INSPIREWORKSS"
    title="Resources"
    lead="Complex engineering concepts, simplified — with a focus on both the how and the why."
    sheet="06 / 07"
    meta={[
      { label: 'Title', value: 'Resources' },
      { label: 'Videos', value: `${pad(videos.length)} tutorials` },
      { label: 'Channel', value: site.social.youtube.handle },
    ]}
    trail={trail}
  />

  <section class="py-16 sm:py-20 lg:py-24" aria-labelledby="videos-title">
    <div class="container-x">
      <SectionHeading mark="A" eyebrow="YouTube" id="videos-title" title="Tutorials from the channel." />

      {
        lead && (
          <article class="mt-12 grid gap-8 lg:grid-cols-12 lg:items-end" data-reveal>
            <div class="lg:col-span-8">
              <VideoFacade id={lead.id} title={lead.data.title} sizes="(min-width: 64rem) 60vw, 100vw" eager />
            </div>
            <div class="lg:col-span-4">
              <p class="eyebrow">Tutorial 01 · {lead.data.topic}</p>
              <h3 class="heading-lg mt-3">{lead.data.title}</h3>
              <a href={youtubeUrl(lead.id)} class="link-arrow mt-6" target="_blank" rel="noopener">
                Watch on YouTube <Icon name="arrow-up-right" /><span class="sr-only">(opens in a new tab)</span>
              </a>
            </div>
          </article>
        )
      }

      <ul class="mt-16 grid gap-x-6 gap-y-12 sm:grid-cols-2">
        {
          rest.map((v, i) => (
            <li data-reveal style={`--reveal-i: ${i % 2}`}>
              <VideoFacade id={v.id} title={v.data.title} sizes="(min-width: 40rem) 50vw, 100vw" />
              <p class="eyebrow mt-4">
                Tutorial {pad(i + 2)} · {v.data.topic}
              </p>
              <h3 class="heading-md mt-2">{v.data.title}</h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="grid-paper border-y border-line py-20 sm:py-24" aria-labelledby="channels-title">
    <div class="container-x">
      <SectionHeading mark="B" eyebrow="Follow along" id="channels-title" title="Keep learning." />
      <ul class="mt-12 grid gap-px border border-line bg-line md:grid-cols-2">
        {
          channels.map((c, i) => (
            <li class="bg-sheet" data-reveal style={`--reveal-i: ${i}`}>
              <a href={c.url} target="_blank" rel="me noopener" class="channel">
                <Icon name={c.icon} size={28} />
                <span class="heading-lg mt-6 block">{c.title}</span>
                <span class="mt-2 block text-ink-2">{c.text}</span>
                <span class="link-arrow mt-6">
                  {c.handle} <Icon name="arrow-up-right" />
                </span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTABand title="Want a tutorial or training for your team?" subject="Training / content enquiry — INSPIREWORKSS" />
</BaseLayout>

<style>
  .channel {
    display: block;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    transition: background-color 0.25s ease;
  }

  .channel:hover {
    background: var(--c-paper);
  }

  .channel:hover .heading-lg {
    color: var(--c-accent);
  }
</style>
