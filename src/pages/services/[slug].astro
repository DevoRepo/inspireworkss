---
import { url } from '../../lib/url';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SpecTable from '../../components/SpecTable.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import { mailto } from '../../config/site';
import { getProjects, getServices, pad, resolveSkills, resolveTools, type Service } from '../../lib/content';
import { render } from 'astro:content';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service, i) => ({
    params: { slug: service.id },
    props: { service, prev: services[i - 1], next: services[i + 1], total: services.length },
  }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
  prev?: Service;
  next?: Service;
  total: number;
}

const { service, prev, next, total } = Astro.props;
const { data } = service;
const skills = await resolveSkills(data.skills);
const tools = await resolveTools(data.tools);
const related = (await getProjects()).filter((p) => p.data.services.some((s) => s.id === service.id)).slice(0, 4);
const { Content } = await render(service);
const hasBody = Boolean(service.body?.trim());

const trail = [
  { name: 'Services', href: '/services/' },
  { name: data.title, href: `/services/${service.id}/` },
];

const schema = [
  {
    '@type': 'Service',
    name: data.title,
    description: data.summary,
    serviceType: data.title,
    provider: { '@id': new URL(url('/#organization'), Astro.site).href },
    url: new URL(url(`/services/${service.id}/`), Astro.site).href,
  },
];
---

<BaseLayout title={data.title} description={data.summary} trail={trail} schema={schema}>
  <TitleBlock eyebrow={`Service ${pad(data.order)} of ${pad(total)}`} title={data.title} lead={data.summary} trail={trail}>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={mailto(`Enquiry: ${data.title}`)} class="btn btn-primary">Enquire about this service <Icon name="arrow" /></a>
      <a href={url('/services/')} class="btn btn-ghost">All services</a>
    </div>

    <div slot="aside" class="card brief">
      <h2 class="heading-md">Who it helps</h2>
      <ul class="mt-4 space-y-3">
        {
          data.audience.map((a) => (
            <li class="flex gap-3">
              <span class="brief-check" aria-hidden="true">
                <Icon name="check" size={14} />
              </span>
              <span>{a}</span>
            </li>
          ))
        }
      </ul>
      {
        data.scope.length > 0 && (
          <>
            <p class="label mt-6">Specific scope</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {data.scope.map((sc) => (
                <li class="chip">{sc}</li>
              ))}
            </ul>
          </>
        )
      }
      {
        tools.length > 0 && (
          <>
            <p class="label mt-6">Software</p>
            <p class="mt-2 text-[0.95rem] text-ink-2">{tools.map((t) => t.data.name).join(', ')}</p>
          </>
        )
      }
    </div>
  </TitleBlock>

  <!-- What you get -->
  <section class="pt-16 sm:pt-20 lg:pt-24" aria-labelledby="value-title">
    <div class="container-x">
      <div class="surface surface-blush" data-reveal>
        <p class="eyebrow">Deliverables</p>
        <h2 id="value-title" class="heading-xl mt-4">What you get</h2>
        <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
          {
            data.value.map((v, i) => (
              <li class="border-t border-line-strong pt-5">
                <span class="value-num">{pad(i + 1)}</span>
                <p class="mt-3 text-lg leading-snug">{v}</p>
              </li>
            ))
          }
        </ol>
      </div>

      {
        hasBody && (
          <div class="prose-body mt-12 max-w-3xl text-lg" data-reveal>
            <Content />
          </div>
        )
      }
    </div>
  </section>

  <!-- Scope: skills + tools -->
  {
    (skills.length > 0 || tools.length > 0) && (
      <section class="py-20 sm:py-24 lg:py-28" aria-labelledby="scope-title">
        <div class="container-x">
          <SectionHeading eyebrow="Specification" id="scope-title" title="Skills and software" />
          <div class="mt-12 grid gap-14 lg:grid-cols-12 lg:gap-12">
            {skills.length > 0 && (
              <div class="lg:col-span-7" data-reveal>
                <SpecTable caption="Skills" itemLabel="Skill" rows={skills.map((s) => ({ name: s.data.skill, note: s.data.note }))} />
              </div>
            )}
            {tools.length > 0 && (
              <div class="lg:col-span-5" data-reveal style="--reveal-i: 1">
                <SpecTable caption="Software" itemLabel="Package" noteLabel="Used for" rows={tools.map((t) => ({ name: t.data.name, note: t.data.use }))} />
              </div>
            )}
          </div>
          <a href={url('/expertise/')} class="link-arrow mt-10">All skills and software <Icon name="arrow" /></a>
        </div>
      </section>
    )
  }

  <!-- Related work -->
  {
    related.length > 0 && (
      <section class="pb-20 sm:pb-24 lg:pb-28" aria-labelledby="related-title">
        <div class="container-x">
          <SectionHeading eyebrow="Related work" id="related-title" title="Projects that use this service" />
          <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((p, i) => (
              <li data-reveal style={`--reveal-i: ${i}`}>
                <ProjectCard project={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Prev / next -->
  <nav aria-label="More services" class="border-t border-line">
    <div class="container-x grid sm:grid-cols-2">
      {
        prev ? (
          <a href={url(`/services/${prev.id}/`)} class="pager">
            <span class="label">← Previous service</span>
            <span class="heading-md mt-2 block">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={url(`/services/${next.id}/`)} class="pager sm:text-right">
            <span class="label">Next service →</span>
            <span class="heading-md mt-2 block">{next.data.title}</span>
          </a>
        )
      }
    </div>
  </nav>

  <CTABand title={`Enquire about ${data.title}`} subject={`Enquiry: ${data.title}`} />
</BaseLayout>

<style>
  .brief {
    padding: 1.75rem;
  }

  .brief-check {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.1rem;
    border-radius: 999px;
    background: var(--c-accent);
    color: var(--c-accent-ink);
  }

  .value-num {
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--c-accent);
  }

  .pager {
    display: block;
    padding-block: 2rem;
    transition: color 0.2s ease;
  }

  .pager:hover {
    color: var(--c-accent);
  }

  .pager + .pager {
    border-top: 1px solid var(--c-line);
  }

  @media (min-width: 40rem) {
    .pager + .pager {
      border-top: 0;
    }
  }
</style>
