---
import { url } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import ServiceIndex from '../../components/ServiceIndex.astro';
import FlangeDrawing from '../../components/drawings/FlangeDrawing.astro';
import CTABand from '../../components/CTABand.astro';
import { site } from '../../config/site';
import { getServices, getTools, isEngineeringTool } from '../../lib/content';

const services = await getServices();
const engineeringTools = (await getTools()).filter(isEngineeringTool);
const trail = [{ name: 'Services', href: '/services/' }];

const audiences = [
  { title: 'Companies and manufacturers', text: 'Design, drafting, piping and analysis support, delivered in the software your team already uses.' },
  { title: 'EPC and plant teams', text: 'Piping design, layout, pipe stress and pressure vessel work, checked against ASME and API standards.' },
  { title: 'Students and professionals', text: 'CAD/CAE training and mentoring that explains the how and the why behind every tool.' },
];

const schema = [
  {
    '@type': 'ItemList',
    name: `${site.name} engineering services`,
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.data.title,
      url: new URL(url(`/services/${s.id}/`), Astro.site).href,
    })),
  },
];
---

<BaseLayout
  title="Mechanical Engineering Services"
  description="Mechanical engineering services by INSPIREWORKSS: engineering design and CAD, plant design and piping engineering, mechanical analysis, technical consulting, CAD/CAE training, reverse engineering and remote engineering support."
  trail={trail}
  schema={schema}
>
  <TitleBlock
    eyebrow="Services"
    title="Engineering services"
    lead="Mechanical design, piping and plant engineering, analysis, consulting and training, from a first sketch to a checked and documented design."
    meta={[
      { label: 'Services', value: String(services.length) },
      { label: 'Software', value: `${engineeringTools.length} CAD/CAE packages` },
      { label: 'Standards', value: 'ASME · API · ISO' },
    ]}
    trail={trail}
  >
    <FlangeDrawing slot="aside" />
  </TitleBlock>

  <section class="py-16 sm:py-20 lg:py-24" aria-label="Service list">
    <div class="container-x">
      <ServiceIndex services={services} headingLevel="h2" />
    </div>
  </section>

  <section class="pb-4" aria-labelledby="who-title">
    <div class="container-x">
      <div class="surface surface-tint" data-reveal>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-4">
            <p class="eyebrow">Who it helps</p>
            <h2 id="who-title" class="heading-xl mt-4">Who the services are for</h2>
          </div>
          <ul class="grid gap-8 sm:grid-cols-3 lg:col-span-8 lg:gap-10">
            {
              audiences.map((a) => (
                <li class="border-t border-line-strong pt-5">
                  <h3 class="heading-md">{a.title}</h3>
                  <p class="mt-2 text-ink-2">{a.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    title="Not sure which service fits?"
    text="Describe the problem instead: the component or system, what you need delivered, and any drawings, models or standards involved."
  />
</BaseLayout>
