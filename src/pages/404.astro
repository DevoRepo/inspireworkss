---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { nav } from '../config/site';
---

<BaseLayout title="Page not found" description="This page could not be found on the INSPIREWORKSS website." noindex>
  <section class="grid-paper border-b border-line">
    <div class="container-x py-24 sm:py-32">
      <p class="eyebrow">Error 404</p>
      <h1 class="display-xl mt-6">Page not found</h1>
      <p class="lead mt-8 max-w-xl">The page may have moved, or the link may be mistyped. Try one of these instead:</p>
      <ul class="mt-8 flex flex-wrap gap-3">
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} class="btn btn-ghost">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={url('/')} class="btn btn-primary mt-10">Back to home <Icon name="arrow" /></a>
    </div>
  </section>
</BaseLayout>
