---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import VideoListItem from '../../components/VideoListItem.astro';
import Pagination from '../../components/Pagination.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import youtubeConfig from '../../config/youtube.json';
import youtubeMeta from '../../content/youtube-meta.json';
import { formatDate, getYouTubeVideos, youtubeUrl, type YouTubeVideo } from '../../lib/content';
import { url } from '../../lib/url';

/** Long-form videos only (Shorts are excluded when fetched), most viewed first, paginated. */
export const getStaticPaths = (async ({ paginate }) => {
  const videos = await getYouTubeVideos();
  // Always build page 1, even before any videos have been fetched.
  return videos.length ? paginate(videos, { pageSize: youtubeConfig.pageSize }) : [{ params: { page: undefined }, props: { page: undefined } }];
}) satisfies GetStaticPaths;

interface Props {
  page?: Page<YouTubeVideo>;
}

const { page } = Astro.props;
const videos = page?.data ?? [];
const current = page?.currentPage ?? 1;
const last = page?.lastPage ?? 1;
const total = page?.total ?? 0;
const pageHref = (n: number) => url(n === 1 ? '/resources/' : `/resources/${n}/`);
const updated = youtubeMeta.fetchedAt ? formatDate(new Date(youtubeMeta.fetchedAt)) : null;

const trail = [{ name: 'Resources', href: '/resources/' }];
const suffix = current > 1 ? ` — Page ${current}` : '';


const schema = videos.length
  ? [
      {
        '@type': 'ItemList',
        name: `${site.name} tutorials${suffix}`,
        itemListOrder: 'https://schema.org/ItemListOrderDescending',
        itemListElement: videos.map((v, i) => ({
          '@type': 'ListItem',
          position: (page?.start ?? 0) + i + 1,
          url: youtubeUrl(v.id),
          name: v.data.title,
        })),
      },
    ]
  : [];
---

<BaseLayout
  title={`Engineering Tutorials & Resources${suffix}`}
  description={current > 1
    ? `More SolidWorks and mechanical engineering tutorials from INSPIREWORKSS, ranked by views. Page ${current} of ${last}.`
    : 'Free mechanical engineering tutorials from INSPIREWORKSS: SolidWorks modelling builds, design techniques and engineering-drawing exercises, ranked by views and updated automatically.'}
  trail={trail}
  schema={schema}
>
  {
    page?.url.prev && <link slot="head" rel="prev" href={pageHref(current - 1)} />
  }
  {
    page?.url.next && <link slot="head" rel="next" href={pageHref(current + 1)} />
  }

  <TitleBlock
    eyebrow="Resources"
    title="Engineering tutorials"
    lead="Free long-form tutorials from the INSPIREWORKSS YouTube channel. Complex concepts, explained with a focus on both the how and the why."
    meta={[
      { label: 'Tutorials', value: String(total) },
      { label: 'Sorted by', value: 'Most watched' },
      ...(updated ? [{ label: 'Updated', value: updated }] : []),
    ]}
    trail={trail}
  >
    <div slot="aside" class="card channel-card">
      <span class="channel-icon" aria-hidden="true"><Icon name="youtube" size={22} /></span>
      <h2 class="heading-md mt-5">INSPIREWORKSS on YouTube</h2>
      <p class="mt-2 text-ink-2">SolidWorks builds, modelling techniques and engineering-drawing exercises.</p>
      <a href={site.social.youtube.url} class="btn btn-primary mt-6" target="_blank" rel="me noopener">
        Visit the channel <Icon name="arrow-up-right" />
        <span class="sr-only">(opens in a new tab)</span>
      </a>
      <a href={site.social.blog.url} class="blog-row" target="_blank" rel="me noopener">
        <Icon name="blog" size={20} />
        <span class="flex-1">
          <span class="block font-semibold">The blog</span>
          <span class="block text-sm text-ink-3">Written engineering notes by {site.owner}</span>
        </span>
        <Icon name="arrow-up-right" size={18} />
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </TitleBlock>

  <section class="py-16 sm:py-20 lg:py-24" aria-labelledby="videos-title">
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          eyebrow="YouTube"
          id="videos-title"
          title="Most watched first"
          intro="Ranked by views and refreshed automatically from the channel. Shorts are not included."
        />
        {last > 1 && <p class="label shrink-0" data-reveal>Page {current} of {last}</p>}
      </div>

      {
        videos.length > 0 ? (
          <>
            <div class="mt-10 border-t border-line-strong">
              {videos.map((v, i) => (
                <VideoListItem video={v} rank={(page?.start ?? 0) + i + 1} eager={i === 0} />
              ))}
            </div>
            <Pagination current={current} last={last} href={pageHref} label="Tutorial pages" />
          </>
        ) : (
          <div class="mt-10 border-t border-line-strong py-12" data-reveal>
            <p class="lead max-w-xl">New tutorials are on their way. In the meantime, the full library is on the YouTube channel.</p>
            <a href={site.social.youtube.url} class="btn btn-primary mt-8" target="_blank" rel="noopener">
              Visit the channel <Icon name="arrow-up-right" />
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
        )
      }
    </div>
  </section>

  <CTABand
    title="Want a tutorial or training for your team?"
    text="Send a short email about the software, the topics you need and who the training is for."
    subject="Training or content enquiry: INSPIREWORKSS"
  />
</BaseLayout>

<style>
  .channel-card {
    padding: 1.75rem;
  }

  .channel-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.875rem;
    background: var(--c-accent);
    color: var(--c-accent-ink);
  }

  .blog-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line);
    transition: color 0.2s ease;
  }

  .blog-row:hover {
    color: var(--c-accent);
  }
</style>
