---
import VideoFacade from './VideoFacade.astro';
import Icon from './Icon.astro';
import { formatDate, formatDuration, formatViews, youtubeUrl, type YouTubeVideo } from '../lib/content';

interface Props {
  video: YouTubeVideo;
  /** Popularity rank across all pages (1 = most viewed). */
  rank: number;
  eager?: boolean;
}

const { video, rank, eager = false } = Astro.props;
const { data } = video;
const stats = [formatViews(data.views), formatDate(data.publishedAt), ...(data.duration ? [formatDuration(data.duration)] : [])];
---

<article class="row" data-reveal>
  <div class="media">
    <VideoFacade id={video.id} title={data.title} sizes="(min-width: 64rem) 42vw, 100vw" eager={eager} />
  </div>

  <div class="info">
    <p class="flex flex-wrap items-center gap-2.5">
      <span class="rank">#{rank}</span>
      {rank === 1 && <span class="badge">Most watched</span>}
    </p>
    <h3 class="heading-lg mt-2">{data.title}</h3>
    <p class="stats">
      {stats.map((s) => <span>{s}</span>)}
    </p>

    {data.summary && <p class="mt-4 text-ink-2">{data.summary}</p>}

    {
      data.topics.length > 0 && (
        <div class="mt-6">
          <p class="label">What you'll learn</p>
          <ul class="topics mt-3">
            {data.topics.map((t) => (
              <li>
                <Icon name="check" size={16} />
                {t}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <a href={youtubeUrl(video.id)} class="link-arrow mt-6" target="_blank" rel="noopener">
      Watch on YouTube <Icon name="arrow-up-right" />
      <span class="sr-only">(opens in a new tab)</span>
    </a>
  </div>
</article>

<style>
  .row {
    display: grid;
    gap: 1.5rem;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--c-line);
  }

  .rank {
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--c-accent);
  }

  .badge {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    background: var(--c-ink);
    color: var(--c-paper);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    color: var(--c-ink-3);
  }

  .stats span + span::before {
    content: '·';
    margin-inline: 0.55rem;
  }

  .topics {
    display: grid;
    gap: 0.45rem 1.5rem;
    font-size: 0.95rem;
    color: var(--c-ink-2);
  }

  .topics li {
    display: flex;
    gap: 0.55rem;
  }

  .topics li :global(svg) {
    flex: none;
    margin-top: 0.2em;
    color: var(--c-accent);
  }

  @media (min-width: 40rem) {
    .topics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
      align-items: start;
      padding-block: 3rem;
    }
  }
</style>
