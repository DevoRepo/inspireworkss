---
/**
 * Specification-sheet table: item · description · applied in.
 * No self-rated levels — evidence of use (linked services) is shown instead.
 */
import { url } from '../lib/url';
import type { Tool } from '../lib/content';
import SoftwareIcon from './SoftwareIcon.astro';

interface Row {
  name: string;
  note?: string;
  /** Where the item is applied, e.g. services that use the skill. */
  links?: { label: string; href: string }[];
  /** Shows the software icon tile before the name. */
  tool?: Tool;
}

interface Props {
  caption: string;
  rows: Row[];
  itemLabel?: string;
  noteLabel?: string;
  /** Visually hide the caption when a visible heading already describes the table. */
  hideCaption?: boolean;
}

const { caption, rows, itemLabel = 'Item', noteLabel = 'Description', hideCaption = false } = Astro.props;
const hasNotes = rows.some((r) => r.note);
const hasLinks = rows.some((r) => r.links?.length);
---

<div class="spec-wrap">
  <table class:list={['spec', { 'has-links': hasLinks }]}>
    <caption class:list={[hideCaption ? 'sr-only' : 'eyebrow']}>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{itemLabel}</th>
        {hasNotes && <th scope="col" class="col-wide">{noteLabel}</th>}
        {hasLinks && <th scope="col" class="col-wide">Applied in</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">
              {row.tool ? (
                <span class="flex items-center gap-3">
                  <SoftwareIcon tool={row.tool} />
                  {row.name}
                </span>
              ) : (
                row.name
              )}
              {row.note && <span class="note-sm">{row.note}</span>}
              {row.links?.length ? (
                <span class="links-sm">
                  {row.links.map((l) => (
                    <a href={url(l.href)}>{l.label}</a>
                  ))}
                </span>
              ) : null}
            </th>
            {hasNotes && <td class="col-wide text-ink-2">{row.note}</td>}
            {hasLinks && (
              <td class="col-wide">
                <span class="links">
                  {row.links?.map((l) => (
                    <a href={url(l.href)}>{l.label}</a>
                  ))}
                </span>
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .spec-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .spec {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }

  caption {
    text-align: left;
    padding-bottom: 0.75rem;
  }

  thead th {
    padding: 0 1.25rem 0.75rem 0;
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--c-ink-3);
    border-bottom: 1px solid var(--c-line-strong);
  }

  tbody th,
  tbody td {
    padding: 1.15rem 1.25rem 1.15rem 0;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
    border-bottom: 1px solid var(--c-line);
  }

  tbody th {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* Fixed column widths so every table on a page lines up. */
  @media (min-width: 48rem) {
    .spec {
      table-layout: fixed;
    }

    thead th:first-child {
      width: 32%;
    }

    .spec.has-links thead th:nth-child(2) {
      width: 36%;
    }
  }

  .links,
  .links-sm {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .links a,
  .links-sm a {
    font-size: 0.9375rem;
    font-weight: 450;
    line-height: 1.4;
    color: var(--c-ink-2);
    text-decoration: underline;
    text-decoration-color: var(--c-line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .links a:hover,
  .links-sm a:hover {
    color: var(--c-accent);
    text-decoration-color: var(--c-accent);
  }

  /* Small screens: description and links stack under the item name. */
  .note-sm {
    display: block;
    margin-top: 0.25rem;
    font-weight: 400;
    font-size: 0.9375rem;
    letter-spacing: 0;
    color: var(--c-ink-2);
  }

  .links-sm {
    margin-top: 0.6rem;
  }

  .col-wide {
    display: none;
  }

  /* Scoped styles sit outside Tailwind's layers, so responsive switching is done here. */
  @media (min-width: 48rem) {
    .note-sm,
    .links-sm {
      display: none;
    }

    .col-wide {
      display: table-cell;
    }
  }
</style>
