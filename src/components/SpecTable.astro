---
/**
 * Specification-sheet table: item · description · applied in.
 * No self-rated levels — evidence of use (linked services) is shown instead.
 */
import { url } from '../lib/url';

interface Row {
  name: string;
  note?: string;
  /** Where the item is applied, e.g. services that use the skill. */
  links?: { label: string; href: string }[];
}

interface Props {
  caption: string;
  rows: Row[];
  itemLabel?: string;
  noteLabel?: string;
  /** Visually hide the caption when a visible heading already describes the table. */
  hideCaption?: boolean;
}

const { caption, rows, itemLabel = 'Item', noteLabel = 'Description', hideCaption = false } = Astro.props;
const hasNotes = rows.some((r) => r.note);
const hasLinks = rows.some((r) => r.links?.length);
---

<div class="spec-wrap">
  <table class="spec">
    <caption class:list={[hideCaption ? 'sr-only' : 'eyebrow']}>{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="w-[3rem]">No.</th>
        <th scope="col">{itemLabel}</th>
        {hasNotes && <th scope="col" class="col-wide">{noteLabel}</th>}
        {hasLinks && <th scope="col" class="col-wide">Applied in</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, i) => (
          <tr>
            <td class="mono text-ink-3">{String(i + 1).padStart(2, '0')}</td>
            <th scope="row">
              {row.name}
              {row.note && <span class="note-sm">{row.note}</span>}
              {row.links?.length ? (
                <span class="links-sm">
                  {row.links.map((l) => (
                    <a href={url(l.href)}>{l.label}</a>
                  ))}
                </span>
              ) : null}
            </th>
            {hasNotes && <td class="col-wide text-ink-2">{row.note}</td>}
            {hasLinks && (
              <td class="col-wide">
                <span class="links">
                  {row.links?.map((l) => (
                    <a href={url(l.href)}>{l.label}</a>
                  ))}
                </span>
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .spec-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .spec {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.98rem;
  }

  caption {
    text-align: left;
    padding-bottom: 0.75rem;
  }

  thead th {
    padding: 0.55rem 0.75rem 0.55rem 0;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    border-top: 1px solid var(--c-ink);
    border-bottom: 1px solid var(--c-ink);
  }

  tbody th,
  tbody td {
    padding: 0.85rem 0.75rem 0.85rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--c-line);
  }

  tbody th {
    font-weight: 600;
  }

  tbody td:first-child {
    font-size: 0.75rem;
    padding-top: 1.05rem;
  }

  tbody tr {
    transition: background-color 0.2s ease;
  }

  tbody tr:hover {
    background: var(--c-sheet);
  }

  .links,
  .links-sm {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
  }

  .links a,
  .links-sm a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--c-ink);
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-underline-offset: 0.2em;
    transition: color 0.2s;
  }

  .links a:hover,
  .links-sm a:hover {
    color: var(--c-accent);
  }

  /* Small screens: description and links stack under the item name. */
  .note-sm {
    display: block;
    margin-top: 0.2rem;
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--c-ink-2);
  }

  .links-sm {
    margin-top: 0.4rem;
  }

  .col-wide {
    display: none;
  }

  /* Scoped styles sit outside Tailwind's layers, so responsive switching is done here. */
  @media (min-width: 48rem) {
    .note-sm,
    .links-sm {
      display: none;
    }

    .col-wide {
      display: table-cell;
    }
  }
</style>
