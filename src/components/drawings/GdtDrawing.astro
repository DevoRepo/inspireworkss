---
/**
 * GD&T drawing of a mounting plate (200 × 120 × 12 mm): front view with a four-hole pattern and a
 * centre bore, a side view, datum features A–C, a position tolerance on the holes and a flatness
 * tolerance on datum A, dimensioned to ASME Y14.5 conventions. Drawn to scale.
 */
const k = 1.3; // drawing units per millimetre
const f = (n: number) => n.toFixed(1);

const x0 = 80;
const y0 = 120;
const W = 200 * k;
const H = 120 * k;
const T = 12 * k;
const inset = 15 * k;
const rHole = 6 * k;
const rBore = 20 * k;
const cx = x0 + W / 2;
const cy = y0 + H / 2;
const holes = [
  { x: x0 + inset, y: y0 + inset },
  { x: x0 + W - inset, y: y0 + inset },
  { x: x0 + inset, y: y0 + H - inset },
  { x: x0 + W - inset, y: y0 + H - inset },
];
const sx = 400; // side view: front face
const sb = sx + T; // side view: back face (datum A)

// Feature control frame for the hole pattern: position Ø0.2 at MMC to A|B|C
const fcf = { x: x0, y: 78, h: 20, cells: [24, 72, 20, 20, 20] };
const fcfX = fcf.cells.reduce<number[]>((acc, w) => [...acc, acc[acc.length - 1] + w], [fcf.x]);
const fcfMid = fcf.y + fcf.h / 2;

// Leader from the frame to the top-left hole edge
const lp = { x: fcf.x + 12, y: fcf.y + fcf.h };
const hl = holes[0];
const ldx = lp.x - hl.x;
const ldy = lp.y - hl.y;
const ll = Math.hypot(ldx, ldy);
const holeEdge = { x: hl.x + (rHole * ldx) / ll, y: hl.y + (rHole * ldy) / ll };

const datum = (letter: string, bx: number, by: number) => ({ letter, bx, by });
const datums = [datum('B', 38, cy - 9), datum('C', 141, y0 + H + 24), datum('A', sb + 24, cy - 9)];
---

<svg class="drawing" viewBox="0 0 600 420" role="img" aria-labelledby="gdt-title">
  <title id="gdt-title">GD&T drawing of a mounting plate with datum features A, B and C, a position tolerance on the hole pattern and a flatness tolerance</title>
  <defs>
    <marker id="dwg-arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0 1.5 10 5 0 8.5z" class="arrowhead"></path>
    </marker>
  </defs>

  <!-- Centre lines -->
  <g class="later" style="--d: 0s">
    {holes.map((p) => <path d={`M${f(p.x - 14)} ${f(p.y)}h28M${f(p.x)} ${f(p.y - 14)}v28`} class="chain" style="stroke-dasharray: 8 3 2 3" />)}
    <path d={`M${f(cx - rBore - 16)} ${f(cy)}H${f(cx + rBore + 16)}M${f(cx)} ${f(cy - rBore - 16)}V${f(cy + rBore + 16)}`} class="chain"></path>
    {[...holes.slice(0, 1), holes[2]].map((p) => <line x1={sx - 10} y1={f(p.y)} x2={f(sb + 10)} y2={f(p.y)} class="chain" style="stroke-dasharray: 8 3 2 3" />)}
    <line x1={sx - 10} y1={f(cy)} x2={f(sb + 10)} y2={f(cy)} class="chain" style="stroke-dasharray: 8 3 2 3"></line>
  </g>

  <!-- Front view -->
  <rect x={x0} y={y0} width={W} height={H} pathLength="1" class="obj draw" style="--d: 0.05s"></rect>
  {holes.map((p, i) => <circle cx={f(p.x)} cy={f(p.y)} r={f(rHole)} pathLength="1" class="feat draw" style={`--d: ${0.4 + i * 0.08}s`} />)}
  <circle cx={f(cx)} cy={f(cy)} r={f(rBore)} pathLength="1" class="obj draw" style="--d: 0.3s"></circle>

  <!-- Side view, with the holes and bore as hidden lines -->
  <rect x={sx} y={y0} width={f(T)} height={H} pathLength="1" class="obj draw" style="--d: 0.2s"></rect>
  <g class="later" style="--d: 0.9s">
    {
      [holes[0].y - rHole, holes[0].y + rHole, holes[2].y - rHole, holes[2].y + rHole, cy - rBore, cy + rBore].map((y) => (
        <line x1={sx} y1={f(y)} x2={f(sb)} y2={f(y)} class="dash" style="stroke-dasharray: 3 2.5" />
      ))
    }
  </g>

  <!-- Datum features A, B, C -->
  <g class="later" style="--d: 1.1s">
    <path d={`M${x0} ${f(cy - 7)} ${x0} ${f(cy + 7)} ${x0 - 9} ${f(cy)}Z`} class="solid"></path>
    <line x1={x0 - 9} y1={f(cy)} x2="56" y2={f(cy)} class="thin" style="stroke: var(--c-ink)"></line>
    <path d={`M${cx - 67} ${f(y0 + H)} ${cx - 53} ${f(y0 + H)} ${cx - 60} ${f(y0 + H + 9)}Z`} class="solid"></path>
    <line x1={cx - 60} y1={f(y0 + H + 9)} x2={cx - 60} y2={f(y0 + H + 24)} class="thin" style="stroke: var(--c-ink)"></line>
    <path d={`M${f(sb)} ${f(cy - 7)} ${f(sb)} ${f(cy + 7)} ${f(sb + 9)} ${f(cy)}Z`} class="solid"></path>
    <line x1={f(sb + 9)} y1={f(cy)} x2={f(sb + 24)} y2={f(cy)} class="thin" style="stroke: var(--c-ink)"></line>
    {
      datums.map((d) => (
        <>
          <rect x={d.letter === 'C' ? cx - 69 : d.bx} y={f(d.by)} width="18" height="18" class="thin" style="stroke: var(--c-ink); fill: var(--c-paper)" />
          <text x={f((d.letter === 'C' ? cx - 69 : d.bx) + 9)} y={f(d.by + 13)} text-anchor="middle" class="t-strong">
            {d.letter}
          </text>
        </>
      ))
    }
  </g>

  <!-- Position tolerance on the 4-hole pattern -->
  <g class="later" style="--d: 1.3s">
    <text x={fcf.x} y={fcf.y - 8} class="t-strong">4× Ø12</text>
    <rect x={fcf.x} y={fcf.y} width={fcfX[fcfX.length - 1] - fcf.x} height={fcf.h} class="thin" style="stroke: var(--c-ink); fill: var(--c-paper)"></rect>
    {fcfX.slice(1, -1).map((x) => <line x1={x} y1={fcf.y} x2={x} y2={fcf.y + fcf.h} class="thin" style="stroke: var(--c-ink)" />)}
    <!-- position symbol -->
    <circle cx={fcfX[0] + 12} cy={fcfMid} r="4.5" class="thin" style="stroke: var(--c-ink)"></circle>
    <path d={`M${fcfX[0] + 4} ${fcfMid}h16M${fcfX[0] + 12} ${fcfMid - 8}v16`} class="thin" style="stroke: var(--c-ink)"></path>
    <text x={fcfX[1] + 6} y={fcfMid + 4} class="t-strong">Ø0.2</text>
    <circle cx={fcfX[2] - 13} cy={fcfMid} r="6" class="thin" style="stroke: var(--c-ink)"></circle>
    <text x={fcfX[2] - 13} y={fcfMid + 3.5} text-anchor="middle" class="t-strong" style="font-size: 9px">M</text>
    {['A', 'B', 'C'].map((l, i) => <text x={fcfX[2 + i] + 10} y={fcfMid + 4} text-anchor="middle" class="t-strong">{l}</text>)}
    <polyline points={`${lp.x},${lp.y} ${f(holeEdge.x)},${f(holeEdge.y)}`} class="thin" marker-end="url(#dwg-arrow)"></polyline>
  </g>

  <!-- Flatness on datum A -->
  <g class="later" style="--d: 1.4s">
    <rect x="452" y="78" width="66" height="20" class="thin" style="stroke: var(--c-ink); fill: var(--c-paper)"></rect>
    <line x1="476" y1="78" x2="476" y2="98" class="thin" style="stroke: var(--c-ink)"></line>
    <path d="M457 92 462 84 471 84 466 92Z" class="thin" style="stroke: var(--c-ink)"></path>
    <text x="482" y="92" class="t-strong">0.05</text>
    <polyline points={`452,88 ${f(sb + 18)},88 ${f(sb)},146`} class="thin" marker-end="url(#dwg-arrow)"></polyline>
  </g>

  <!-- Bore callout and basic dimensions -->
  <g class="later" style="--d: 1.5s">
    <polyline points={`${f(cx + rBore * 0.707)},${f(cy - rBore * 0.707)} 288,98 336,98`} class="thin" marker-start="url(#dwg-arrow)"></polyline>
    <text x="291" y="92">Ø40 H7</text>

    <path d={`M${f(holes[2].x)} ${f(holes[2].y + rHole + 4)}V352M${f(holes[3].x)} ${f(holes[3].y + rHole + 4)}V352`} class="thin"></path>
    <line x1={f(holes[2].x)} y1="345" x2={f(holes[3].x)} y2="345" class="thin" marker-start="url(#dwg-arrow)" marker-end="url(#dwg-arrow)"></line>
    <rect x={f(cx - 17)} y="336" width="34" height="18" class="thin" style="stroke: var(--c-ink); fill: var(--c-paper)"></rect>
    <text x={f(cx)} y="349" text-anchor="middle" class="t-strong">170</text>

    <path d={`M${f(holes[1].x + rHole + 4)} ${f(holes[1].y)}H378M${f(holes[3].x + rHole + 4)} ${f(holes[3].y)}H378`} class="thin"></path>
    <line x1="370" y1={f(holes[1].y)} x2="370" y2={f(holes[3].y)} class="thin" marker-start="url(#dwg-arrow)" marker-end="url(#dwg-arrow)"></line>
    <rect x="355" y={f(cy - 9)} width="30" height="18" class="thin" style="stroke: var(--c-ink); fill: var(--c-paper)"></rect>
    <text x="370" y={f(cy + 4)} text-anchor="middle" class="t-strong">90</text>

    <text x="24" y="408" class="t-small">PLATE 200 × 120 × 12 · ASME Y14.5 · MM</text>
  </g>
</svg>
