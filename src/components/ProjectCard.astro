---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<a href={url(`/projects/${project.id}/`)} class="card project-card">
  <span class="thumb">
    <Image src={project.data.cover} alt="" widths={[360, 540, 720]} sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw" />
  </span>
  <span class="body">
    <span class="block text-sm text-ink-3">{project.data.category}</span>
    <Heading class="heading-md mt-1">{project.data.title}</Heading>
  </span>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .project-card:hover {
    border-color: var(--c-ink);
  }

  .thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #fff;
    border-bottom: 1px solid var(--c-line);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project-card:hover .thumb :global(img) {
    transform: scale(1.04);
  }

  .body {
    display: block;
    padding: 1.1rem 1.25rem 1.3rem;
  }

  .project-card:hover h2,
  .project-card:hover h3 {
    color: var(--c-accent);
  }
</style>
