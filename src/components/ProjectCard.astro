---
import { Image } from 'astro:assets';
import type { Project } from '../lib/content';
import { pad } from '../lib/content';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<a href={`/projects/${project.id}/`} class="card">
  <span class="thumb">
    <Image src={project.data.cover} alt="" widths={[360, 540, 720]} sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw" />
  </span>
  <span class="eyebrow mt-4 block">Fig. {pad(project.data.order)} · {project.data.category}</span>
  <Heading class="heading-md mt-2">{project.data.title}</Heading>
</a>

<style>
  .card {
    display: block;
  }

  .thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--c-line);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card:hover .thumb :global(img) {
    transform: scale(1.04);
  }

  .card:hover h2,
  .card:hover h3 {
    color: var(--c-accent);
  }
</style>
