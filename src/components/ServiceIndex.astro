---
import { url } from '../lib/url';
import type { Service } from '../lib/content';
import { pad, resolveTools } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  services: Service[];
  headingLevel?: 'h2' | 'h3';
}

const { services, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const rows = await Promise.all(services.map(async (s) => ({ s, tools: await resolveTools(s.data.tools) })));
---

<ol class="svc-index">
  {
    rows.map(({ s, tools }, i) => (
      <li data-reveal style={`--reveal-i: ${i % 4}`}>
        <a href={url(`/services/${s.id}/`)} class="svc-row">
          <span class="svc-num mono">{pad(s.data.order)}</span>
          <span class="svc-main">
            <Heading class="svc-title">{s.data.title}</Heading>
            <span class="svc-summary">{s.data.summary}</span>
          </span>
          <span class="svc-tools">
            {tools.slice(0, 3).map((t) => <span class="chip">{t.data.name}</span>)}
            {tools.length > 3 && <span class="chip">+{tools.length - 3}</span>}
          </span>
          <span class="svc-arrow" aria-hidden="true">
            <Icon name="arrow" size={22} />
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .svc-index {
    border-top: 1px solid var(--c-ink);
  }

  .svc-index li {
    border-bottom: 1px solid var(--c-line);
  }

  .svc-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 0.5rem 1rem;
    padding: 1.4rem 0.25rem;
    transition: background-color 0.25s ease, padding 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .svc-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 3px;
    background: var(--c-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .svc-row:hover {
    background: var(--c-sheet);
    padding-left: 1rem;
  }

  .svc-row:hover::before {
    transform: scaleY(1);
  }

  .svc-num {
    padding-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--c-accent);
  }

  .svc-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.028em;
  }

  .svc-summary {
    display: block;
    margin-top: 0.5rem;
    max-width: 40rem;
    font-size: 0.98rem;
    color: var(--c-ink-2);
  }

  .svc-tools {
    grid-column: 2 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .svc-tools:empty {
    display: none;
  }

  .svc-arrow {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--c-ink);
    box-shadow: inset 0 0 0 1px var(--c-line-strong);
    transition: background-color 0.25s, color 0.25s, box-shadow 0.25s;
  }

  .svc-row:hover .svc-arrow {
    background: var(--c-accent);
    color: var(--c-accent-ink);
    box-shadow: none;
  }

  @media (min-width: 64rem) {
    .svc-row {
      grid-template-columns: 3.5rem minmax(0, 1.1fr) minmax(0, 0.9fr) 2.75rem;
      align-items: center;
      padding-block: 1.75rem;
    }

    .svc-tools {
      grid-column: 3;
      grid-row: 1;
      justify-content: flex-end;
    }

    .svc-arrow {
      grid-column: 4;
      align-self: center;
    }

    .svc-num {
      align-self: start;
    }
  }
</style>
