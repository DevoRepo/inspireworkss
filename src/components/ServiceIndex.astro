---
import { url } from '../lib/url';
import type { Service } from '../lib/content';
import { pad, resolveTools } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  services: Service[];
  headingLevel?: 'h2' | 'h3';
}

const { services, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const rows = await Promise.all(services.map(async (s) => ({ s, tools: await resolveTools(s.data.tools) })));

/** "SolidWorks, AutoCAD and Autodesk Inventor" / "… and 2 more". */
function toolLine(names: string[]): string {
  if (names.length === 0) return '';
  if (names.length <= 3) return names.length === 1 ? names[0] : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
  return `${names.slice(0, 3).join(', ')} and ${names.length - 3} more`;
}
---

<ol class="svc-index">
  {
    rows.map(({ s, tools }, i) => (
      <li data-reveal style={`--reveal-i: ${i % 4}`}>
        <a href={url(`/services/${s.id}/`)} class="svc-row">
          <span class="svc-num">{pad(s.data.order)}</span>
          <span class="svc-main">
            <Heading class="svc-title">{s.data.title}</Heading>
            <span class="svc-summary">{s.data.summary}</span>
            {tools.length > 0 && <span class="svc-tools">{toolLine(tools.map((t) => t.data.name))}</span>}
          </span>
          <span class="svc-arrow" aria-hidden="true">
            <Icon name="arrow" size={20} />
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .svc-index {
    border-top: 1px solid var(--c-line-strong);
  }

  .svc-index li {
    border-bottom: 1px solid var(--c-line);
  }

  .svc-row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 2.75rem;
    gap: 0.5rem 1rem;
    padding: 1.6rem 0;
  }

  .svc-num {
    padding-top: 0.45rem;
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--c-ink-3);
    transition: color 0.25s ease;
  }

  .svc-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.028em;
    transition: color 0.25s ease;
  }

  .svc-summary {
    display: block;
    margin-top: 0.5rem;
    max-width: 44rem;
    color: var(--c-ink-2);
  }

  .svc-tools {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--c-ink-3);
  }

  .svc-arrow {
    align-self: start;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--c-ink);
    box-shadow: inset 0 0 0 1px var(--c-line-strong);
    transition: background-color 0.25s, color 0.25s, box-shadow 0.25s, transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .svc-row:hover .svc-title,
  .svc-row:hover .svc-num {
    color: var(--c-accent);
  }

  .svc-row:hover .svc-arrow {
    background: var(--c-accent);
    color: var(--c-accent-ink);
    box-shadow: none;
    transform: translateX(3px);
  }

  @media (min-width: 64rem) {
    .svc-row {
      grid-template-columns: 4rem minmax(0, 1fr) 2.75rem;
      gap: 0.5rem 2rem;
      padding-block: 2rem;
    }

    .svc-arrow {
      align-self: center;
    }
  }
</style>
