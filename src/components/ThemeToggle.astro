---
/**
 * Light / dark switch. Light is the default; the choice persists in localStorage ("iw-theme").
 * The pre-paint script in BaseLayout applies the stored theme before first render (no flash).
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Dark theme" title="Toggle dark theme">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path class="half" d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
    <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3" stroke="currentColor" stroke-width="1.2"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    color: var(--c-ink);
    box-shadow: inset 0 0 0 1px var(--c-line-strong);
    background: var(--c-sheet);
    cursor: pointer;
    transition: box-shadow 0.2s ease, color 0.2s ease;
  }

  .theme-toggle:hover {
    box-shadow: inset 0 0 0 1px var(--c-ink);
    color: var(--c-accent);
  }

  .theme-toggle svg {
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global([data-theme='dark']) .theme-toggle svg {
    transform: rotate(180deg);
  }
</style>

<script>
  const KEY = 'iw-theme';
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  function sync() {
    const dark = root.dataset.theme === 'dark';
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => btn.setAttribute('aria-pressed', String(dark)));
    meta?.setAttribute('content', dark ? '#0f1113' : '#f4f3ee');
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* storage unavailable (private mode) — theme still applies for this page */
      }
      sync();
    }),
  );

  sync();
</script>
