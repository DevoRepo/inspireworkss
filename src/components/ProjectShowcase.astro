---
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import type { Project } from '../lib/content';
import { resolveTools } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  reverse?: boolean;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { project, reverse = false, headingLevel = 'h3', eager = false } = Astro.props;
const { data } = project;
const tools = await resolveTools(data.tools);
const Heading = headingLevel;
const href = url(`/projects/${project.id}/`);
const facts = [data.discipline, data.format, ...tools.map((t) => t.data.name)];
---

<article class:list={['showcase', { reverse }]} data-reveal>
  <a href={href} class="media" tabindex="-1" aria-hidden="true">
    <Image
      src={data.cover}
      alt=""
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 64rem) 58vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
    {
      data.youtubeId && (
        <span class="play">
          <Icon name="play" size={14} />
          Video
        </span>
      )
    }
  </a>

  <div class="info">
    <p class="label">{data.category}</p>
    <Heading class="heading-lg mt-2">
      <a href={href} class="title-link">{data.title}</a>
    </Heading>
    <p class="mt-4 text-ink-2">{data.summary}</p>
    <ul class="facts">
      {facts.map((fact) => <li>{fact}</li>)}
    </ul>
    <a href={href} class="link-arrow mt-7" aria-label={`View project: ${data.title}`}>
      View project <Icon name="arrow" />
    </a>
  </div>
</article>

<style>
  .showcase {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  .media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-card);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--c-line);
  }

  /* Hairline drawn above the image so white renders keep a crisp edge. */
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--c-line);
    pointer-events: none;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .showcase:hover .media :global(img) {
    transform: scale(1.035);
  }

  .play {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem 0.35rem 0.55rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    background: var(--c-accent);
    color: var(--c-accent-ink);
  }

  .title-link {
    background: linear-gradient(currentColor, currentColor) left bottom / 0 2px no-repeat;
    transition: background-size 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .showcase:hover .title-link,
  .title-link:hover {
    background-size: 100% 2px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .facts li {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--c-ink-2);
    background: var(--c-sheet);
  }

  @media (min-width: 64rem) {
    .showcase {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
    }

    .showcase.reverse .media {
      order: 2;
    }
  }
</style>
