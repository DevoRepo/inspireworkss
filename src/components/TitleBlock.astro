---
import { url } from '../lib/url';
/**
 * Inner-page header, built like the home hero: heading and lead on the left, an optional visual on
 * the right (slot "aside": a technical drawing, image or card) and an optional strip of key facts
 * along the bottom edge.
 */
interface Meta {
  label: string;
  value: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  meta?: Meta[];
  trail?: { name: string; href: string }[];
}

const { eyebrow, title, lead, meta = [], trail = [] } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="page-head grid-paper" aria-labelledby="page-title">
  <div class="container-x pb-12 pt-8 sm:pb-14 sm:pt-10 lg:pb-16">
    {
      trail.length > 0 && (
        <nav aria-label="Breadcrumb">
          <ol class="crumbs">
            <li>
              <a href={url('/')}>Home</a>
            </li>
            {trail.map((item, i) => (
              <li>{i === trail.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={url(item.href)}>{item.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class:list={['mt-10 grid gap-12 sm:mt-12', { 'lg:grid-cols-12 lg:items-center lg:gap-10': hasAside }]}>
      <div class:list={[hasAside ? 'lg:col-span-7' : 'max-w-4xl']} data-reveal>
        <p class="eyebrow flex items-center gap-3"><span class="tick" aria-hidden="true"></span>{eyebrow}</p>
        <h1 id="page-title" class="display-lg mt-5">{title}</h1>
        {lead && <p class="lead mt-6 max-w-2xl">{lead}</p>}
        <slot />
      </div>

      {
        hasAside && (
          <div class="aside lg:col-span-5" data-reveal style="--reveal-i: 2">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </div>

  {
    meta.length > 0 && (
      <div class="border-t border-line bg-sheet">
        <dl class="container-x spec-strip">
          {meta.map((cell) => (
            <div>
              <dt>{cell.label}</dt>
              <dd>{cell.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
</section>

<style>
  .page-head {
    border-bottom: 1px solid var(--c-line);
  }

  .tick {
    width: 1.5rem;
    height: 1px;
    flex: none;
    background: var(--c-accent);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    font-size: 0.875rem;
    color: var(--c-ink-3);
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline: 0.55rem;
    color: var(--c-line-strong);
  }

  .crumbs a {
    transition: color 0.2s;
  }

  .crumbs a:hover {
    color: var(--c-accent);
  }

  .crumbs [aria-current] {
    color: var(--c-ink);
  }

  .aside {
    width: 100%;
    max-width: 34rem;
    justify-self: center;
  }
</style>
