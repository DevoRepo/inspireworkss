---
/**
 * Page header styled as an engineering drawing sheet: breadcrumb trail, heading, lead,
 * and a title block (dl) with sheet metadata.
 */
interface Meta {
  label: string;
  value: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  sheet: string;
  meta?: Meta[];
  trail?: { name: string; href: string }[];
}

const { eyebrow, title, lead, sheet, meta = [], trail = [] } = Astro.props;
const cells: Meta[] = [{ label: 'Sheet', value: sheet }, ...meta];
---

<section class="title-block grid-paper" aria-labelledby="page-title">
  <div class="container-x relative pb-10 pt-10 sm:pt-14 lg:pb-14 lg:pt-20">
    {
      trail.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-8">
          <ol class="crumbs">
            <li>
              <a href="/">Home</a>
            </li>
            {trail.map((item, i) => (
              <li>
                {i === trail.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8" data-reveal>
        <p class="eyebrow flex items-center gap-3"><span class="tick" aria-hidden="true"></span>{eyebrow}</p>
        <h1 id="page-title" class="display-lg mt-5">{title}</h1>
        {lead && <p class="lead mt-6 max-w-2xl">{lead}</p>}
        <slot />
      </div>

      <dl class="tb lg:col-span-4" data-reveal style="--reveal-i: 2">
        {
          cells.map((cell) => (
            <div>
              <dt>{cell.label}</dt>
              <dd>{cell.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
  <div class="ruler" aria-hidden="true"></div>
</section>

<style>
  .title-block {
    position: relative;
    border-bottom: 1px solid var(--c-line);
  }

  .tick {
    width: 1.5rem;
    height: 1px;
    background: var(--c-accent);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--c-ink-3);
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline: 0.6rem;
    color: var(--c-line-strong);
  }

  .crumbs a:hover {
    color: var(--c-accent);
  }

  .crumbs [aria-current] {
    color: var(--c-ink);
  }

  .tb {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--c-sheet);
    border: 1px solid var(--c-ink);
  }

  .tb > div {
    padding: 0.7rem 0.85rem 0.8rem;
    border-right: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
    min-width: 0;
  }

  .tb > div:nth-child(2n) {
    border-right: 0;
  }

  .tb > div:first-child {
    background: var(--c-ink);
    color: var(--c-paper);
  }

  .tb > div:first-child dt {
    color: color-mix(in srgb, var(--c-paper) 70%, transparent);
  }

  .tb dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-3);
  }

  .tb dd {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  /* Measuring scale along the bottom edge of the sheet. */
  .ruler {
    height: 10px;
    background-image:
      linear-gradient(90deg, var(--c-line-strong) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-line) 1px, transparent 1px);
    background-size: 64px 10px, 8px 4px;
    background-repeat: repeat-x;
    background-position: left bottom;
  }
</style>
