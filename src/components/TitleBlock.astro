---
import { url } from '../lib/url';
/**
 * Page header: breadcrumb trail, heading, lead, and a short list of key facts
 * set like the notes column of a drawing (label left, value right, hairline rules).
 */
interface Meta {
  label: string;
  value: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  meta?: Meta[];
  trail?: { name: string; href: string }[];
}

const { eyebrow, title, lead, meta = [], trail = [] } = Astro.props;
---

<section class="title-block grid-paper" aria-labelledby="page-title">
  <div class="container-x relative pb-14 pt-10 sm:pt-14 lg:pb-20 lg:pt-20">
    {
      trail.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-8">
          <ol class="crumbs">
            <li>
              <a href={url('/')}>Home</a>
            </li>
            {trail.map((item, i) => (
              <li>
                {i === trail.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={url(item.href)}>{item.name}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-8" data-reveal>
        <p class="eyebrow flex items-center gap-3"><span class="tick" aria-hidden="true"></span>{eyebrow}</p>
        <h1 id="page-title" class="display-lg mt-5">{title}</h1>
        {lead && <p class="lead mt-6 max-w-2xl">{lead}</p>}
        <slot />
      </div>

      {
        meta.length > 0 && (
          <dl class="facts lg:col-span-4" data-reveal style="--reveal-i: 2">
            {meta.map((cell) => (
              <div>
                <dt>{cell.label}</dt>
                <dd>{cell.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>

<style>
  .title-block {
    position: relative;
    border-bottom: 1px solid var(--c-line);
  }

  .tick {
    width: 1.5rem;
    height: 1px;
    background: var(--c-accent);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    font-size: 0.875rem;
    color: var(--c-ink-3);
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline: 0.55rem;
    color: var(--c-line-strong);
  }

  .crumbs a {
    transition: color 0.2s;
  }

  .crumbs a:hover {
    color: var(--c-accent);
  }

  .crumbs [aria-current] {
    color: var(--c-ink);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--c-line);
  }

  .facts > div:first-child {
    border-top: 1px solid var(--c-line);
  }

  .facts dt {
    font-size: 0.875rem;
    color: var(--c-ink-3);
  }

  .facts dd {
    font-size: 0.975rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--c-ink);
  }
</style>
