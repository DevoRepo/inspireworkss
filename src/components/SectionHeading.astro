---
/** Section heading: a short mono caption with a red tick, then the heading and an optional intro. */
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  id?: string;
  level?: 'h2' | 'h3';
}

const { eyebrow, title, intro, id, level = 'h2' } = Astro.props;
const Tag = level;
---

<div class="section-head" data-reveal>
  <p class="eyebrow flex items-center gap-3"><span class="tick" aria-hidden="true"></span>{eyebrow}</p>
  <Tag id={id} class="heading-xl mt-4 max-w-3xl">{title}</Tag>
  {intro && <p class="lead mt-5 max-w-2xl">{intro}</p>}
  <slot />
</div>

<style>
  .tick {
    width: 1.5rem;
    height: 1px;
    flex: none;
    background: var(--c-accent);
  }
</style>
