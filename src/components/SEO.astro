---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import { baseGraph, breadcrumbs, type JsonLd } from '../lib/schema';
import logo from '../assets/brand/inspireworkss-logo.png';

export interface SEOProps {
  title: string;
  description: string;
  /** Defaults to the IW logo. Wide images switch the Twitter card to summary_large_image. */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  /** Breadcrumb trail (excluding Home), e.g. [{ name: 'Services', href: '/services/' }]. */
  trail?: { name: string; href: string }[];
  /** Extra JSON-LD nodes for this page. */
  schema?: JsonLd[];
  noindex?: boolean;
}

const { title, description, image, imageAlt, type = 'website', trail = [], schema = [], noindex = false } = Astro.props as SEOProps;

const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).href;
const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? title : `${title} — ${site.name}`;

const ogSource = image ?? logo;
const ogWidth = Math.min(1200, ogSource.width);
const ogHeight = Math.round((ogWidth * ogSource.height) / ogSource.width);
const og = await getImage({ src: ogSource, width: ogWidth, format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, origin).href;
const isWide = ogSource.width / ogSource.height > 1.3;

const logoImage = await getImage({ src: logo, width: 256, format: 'png' });
const knowsAbout = (await getCollection('expertise')).map((s) => s.data.skill);

const graph: JsonLd[] = [
  ...baseGraph(origin, new URL(logoImage.src, origin).href, knowsAbout),
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: fullTitle,
    description,
    isPartOf: { '@id': new URL('/#website', origin).href },
    about: { '@id': new URL('/#organization', origin).href },
    inLanguage: 'en',
  },
  ...(trail.length ? [breadcrumbs(origin, [{ name: 'Home', href: '/' }, ...trail])] : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content={String(ogWidth)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={imageAlt ?? `${site.name} — IW engineering mark`} />

<meta name="twitter:card" content={isWide ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<script type="application/ld+json" set:html={jsonLd} />
