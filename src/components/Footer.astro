---
import { url } from '../lib/url';
import { nav, site, mailto } from '../config/site';
import { getServices } from '../lib/content';
import Icon from './Icon.astro';
import LogoBadge from './LogoBadge.astro';

const services = await getServices();
const year = new Date().getFullYear();
const socials = [
  { ...site.social.linkedin, icon: 'linkedin' as const },
  { ...site.social.youtube, icon: 'youtube' as const },
  { ...site.social.blog, icon: 'blog' as const },
];
---

<footer class="site-footer">
  <div class="container-x grid gap-12 py-16 md:grid-cols-12 lg:py-20">
    <div class="md:col-span-12 lg:col-span-5">
      <a href={url('/')} class="inline-flex items-center gap-3" aria-label={`${site.name} home`}>
        <LogoBadge size={44} />
        <span class="font-display text-xl font-bold tracking-[0.02em]">{site.name}</span>
      </a>
      <p class="mt-5 max-w-sm text-ink-2">{site.tagline}</p>
      <a href={mailto()} class="footer-email mt-6">
        <Icon name="mail" size={18} />
        {site.email}
      </a>
    </div>

    <nav aria-label="Footer" class="md:col-span-4 lg:col-span-2">
      <h2 class="eyebrow">Pages</h2>
      <ul class="mt-4 space-y-2.5">
        {nav.map((item) => <li><a class="footer-link" href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="md:col-span-4 lg:col-span-3">
      <h2 class="eyebrow">Services</h2>
      <ul class="mt-4 space-y-2.5">
        {services.map((s) => <li><a class="footer-link" href={url(`/services/${s.id}/`)}>{s.data.title}</a></li>)}
      </ul>
    </div>

    <div class="md:col-span-4 lg:col-span-2">
      <h2 class="eyebrow">Connect</h2>
      <ul class="mt-4 space-y-2.5">
        {
          socials.map((s) => (
            <li>
              <a class="footer-link inline-flex items-center gap-2" href={s.url} rel="me noopener" target="_blank">
                <Icon name={s.icon} size={16} />
                {s.label}
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-x flex flex-col gap-2 py-6 text-sm text-ink-3 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} · {site.owner}</p>
      <p>{site.disciplines.join(' · ')} engineering</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-line);
    background: var(--c-sheet);
  }

  .footer-link {
    color: var(--c-ink-2);
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--c-accent);
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.0625rem;
    font-weight: 500;
    overflow-wrap: anywhere;
    color: var(--c-ink);
    text-decoration: underline;
    text-decoration-color: var(--c-line-strong);
    text-underline-offset: 0.3em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .footer-email:hover {
    color: var(--c-accent);
    text-decoration-color: var(--c-accent);
  }
</style>
